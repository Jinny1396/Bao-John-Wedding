rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /guest_notes/{noteId} {
      allow read, write: if true;
    }
    match /site_content/{contentId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read: if true;
    }
  }
}
